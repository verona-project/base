;; Core numeric, equality, and ordering protocols. Client code can constrain a
;; type parameter with
;; (numeric a), (equality a), or (ordering a) and use the corresponding
;; operator symbols.
(protocol numeric (a)
  (+ ((left a) (right a)) a)
  (- ((left a) (right a)) a)
  (* ((left a) (right a)) a)
  (/ ((left a) (right a)) a))

(protocol equality (a)
  (= ((left a) (right a)) bool))

(protocol ordering (a)
  (< ((left a) (right a)) bool)
  (<= ((left a) (right a)) bool)
  (> ((left a) (right a)) bool)
  (>= ((left a) (right a)) bool))

;; Keep implementations generated from one definition so each primitive type
;; has the same numeric, equality, and ordering surface.
(macro implement-numeric (type)
  `((implementation (numeric ,type)
      (function + ((left ,type) (right ,type)) ,type
        (,(symbol-concat "%+-primitive-" type) left right))
      (function - ((left ,type) (right ,type)) ,type
        (,(symbol-concat "%--primitive-" type) left right))
      (function * ((left ,type) (right ,type)) ,type
        (,(symbol-concat "%*-primitive-" type) left right))
      (function / ((left ,type) (right ,type)) ,type
        (,(symbol-concat "%/-primitive-" type) left right)))
    (implementation (equality ,type)
      (function = ((left ,type) (right ,type)) bool
        (,(symbol-concat "%=-primitive-" type) left right)))
    (implementation (ordering ,type)
      (function < ((left ,type) (right ,type)) bool
        (,(symbol-concat "%<-primitive-" type) left right))
      (function <= ((left ,type) (right ,type)) bool
        (,(symbol-concat "%<=-primitive-" type) left right))
      (function > ((left ,type) (right ,type)) bool
        (,(symbol-concat "%>-primitive-" type) left right))
      (function >= ((left ,type) (right ,type)) bool
        (,(symbol-concat "%>=-primitive-" type) left right)))))

(implement-numeric i8)

(implement-numeric i16)

(implement-numeric i32)

(implement-numeric i64)

(implement-numeric u8)

(implement-numeric u16)

(implement-numeric u32)

(implement-numeric u64)

(implement-numeric f32)

(implement-numeric f64)

(implementation (equality bool)
  (function = ((left bool) (right bool)) bool
    (%=-primitive-bool left right)))

;; Core numeric protocols -------------------------------------------------------
;;
;; Verona has fixed-width scalar types rather than arbitrary-precision numeric
;; values.  These aliases make that representation explicit.  `order` is a
;; closed comparison result, not an integer alias.
(type int i64)

(type rational f64)

(type order (sum (less) (equal) (greater)))

(protocol enum (a)
  (succ ((value a)) a)
  (pred ((value a)) a)
  (toEnum ((value int)) a)
  (fromEnum ((value a)) int))

(protocol num (a)
  (+ ((left a) (right a)) a)
  (- ((left a) (right a)) a)
  (* ((left a) (right a)) a)
  (negate ((value a)) a)
  (abs ((value a)) a)
  (signum ((value a)) a))

;; Protocol superclasses are not yet modeled by the compiler, so callers state
;; each required constraint explicitly.
(protocol eq (a)
  (= ((left a) (right a)) bool))

(protocol ord (a)
  (compare ((left a) (right a)) order)
  (< ((left a) (right a)) bool)
  (<= ((left a) (right a)) bool)
  (> ((left a) (right a)) bool)
  (>= ((left a) (right a)) bool)
  (max ((left a) (right a)) a)
  (min ((left a) (right a)) a))

(protocol real (a)
  (toRational ((value a)) rational))

(protocol integral (a)
  (quot ((left a) (right a)) a)
  (rem ((left a) (right a)) a)
  (div ((left a) (right a)) a)
  (mod ((left a) (right a)) a)
  (quotRem ((left a) (right a)) (tuple a a))
  (divMod ((left a) (right a)) (tuple a a)))

;; Bounded has no ordering/numeric superclass. Nullary methods select their
;; concrete result type from context, just like CONVERT's result-directed dispatch.
(protocol bounded (a)
  (minBound () a)
  (maxBound () a))

(generic minBound ())

(generic maxBound ())

(macro implement-builtin-bounded (type lower upper)
  `(implementation (bounded ,type)
     (function minBound () ,type
       ,lower)
     (function maxBound () ,type
       ,upper)))

(implement-builtin-bounded i8 -128 127)

(implement-builtin-bounded i16 -32768 32767)

(implement-builtin-bounded i32 -2147483648 2147483647)

(implement-builtin-bounded i64 -9223372036854775808 9223372036854775807)

(implement-builtin-bounded u8 0 255)

(implement-builtin-bounded u16 0 65535)

(implement-builtin-bounded u32 0 4294967295)

(implement-builtin-bounded u64 0 18446744073709551615)

;; isize, usize, exit-code and int are aliases of these existing integer types.
(implement-builtin-bounded bool false true)

(implement-builtin-bounded unit unit unit)

(implement-builtin-bounded order (less) (greater))

(export
  macro
  type
  function
  external-function
  constant
  variable
  generic
  protocol
  implementation
  cond
  and
  or
  not
  and-then
  or-else
  int
  rational
  order
  enum
  num
  eq
  ord
  real
  integral
  bounded
  minBound
  maxBound
  convert
  numeric
  equality
  ordering)

(import base)

(base:function total (for (a) ((base:numeric a))) ((left a) (right a)) a
  (+ left right))

(base:function same (for (a) ((base:equality a))) ((left a) (right a)) bool
  (= left right))

(base:function less (for (a) ((base:ordering a))) ((left a) (right a)) bool
  (< left right))

(base:function less-or-equal (for (a) ((base:ordering a))) ((left a) (right a)) bool
  (<= left right))

(base:function greater (for (a) ((base:ordering a))) ((left a) (right a)) bool
  (> left right))

(base:function greater-or-equal (for (a) ((base:ordering a))) ((left a) (right a)) bool
  (>= left right))

(base:function main () exit-code
  (match (same (total (cast i32 20) (cast i32 22)) (cast i32 42))
    (true
      (match (less (cast i32 42) (cast i32 43))
        (true
          (match (less-or-equal (cast i32 42) (cast i32 42))
            (true
              (match (greater (cast i32 43) (cast i32 42))
                (true (match (greater-or-equal (cast i32 43) (cast i32 43)) (true 0) (false 1)))
                (false 1)))
            (false 1)))
        (false 1)))
    (false 1)))
